# Railway Environment Variables (Minimal)
# ONLY 3 REQUIRED VARIABLES!

# Required Security (MUST CHANGE TO RANDOM VALUES!)
SESSION_SECRET=generate-random-string-here-min-32-chars
HONEYPOT_SECRET=generate-another-random-string-here

# Required
NODE_ENV=production

# Railway provides these automatically:
# PORT=3000 (auto-set by Railway)
# RAILWAY_ENVIRONMENT=production (auto-set)

# Optional (app will use defaults if not set):
# DATABASE_URL=file:./data/data.db
# ALLOW_INDEXING=true