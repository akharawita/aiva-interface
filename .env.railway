# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# Database
DATABASE_URL=file:./data/data.db?connection_limit=1
DATABASE_PATH=./data/data.db

# Security (CHANGE THESE TO RANDOM VALUES!)
SESSION_SECRET=super-duper-s3cret-change-this-to-random-string
HONEYPOT_SECRET=honeypot-secret-change-this-to-random-string

# App Settings
NODE_ENV=production
ALLOW_INDEXING=true
PORT=3000
MOCKS=false

# Internal
INTERNAL_COMMAND_TOKEN=some-random-token-change-this

# Mock GitHub (for compatibility - not used in production)
GITHUB_CLIENT_ID=MOCK_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=MOCK_GITHUB_CLIENT_SECRET
GITHUB_TOKEN=MOCK_GITHUB_TOKEN