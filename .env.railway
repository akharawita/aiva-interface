# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# Database
DATABASE_URL="file:./data/data.db?connection_limit=1"
DATABASE_PATH="./data/data.db"

# Security
SESSION_SECRET="your-super-secret-session-key-change-this"
HONEYPOT_SECRET="your-honeypot-secret-change-this"

# App Settings
NODE_ENV="production"
ALLOW_INDEXING="true"

# Not needed for planning poker but kept for compatibility
INTERNAL_COMMAND_TOKEN="some-token-change-this"

# Mock GitHub (planning poker doesn't use auth but mocks might reference)
GITHUB_CLIENT_ID="MOCK_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="MOCK_GITHUB_CLIENT_SECRET"
GITHUB_TOKEN="MOCK_GITHUB_TOKEN"
GITHUB_REDIRECT_URI="https://your-app.railway.app/auth/github/callback"