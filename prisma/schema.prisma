// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlanningPokerSession {
  id          String   @id @default(cuid())
  sessionCode String   @unique
  name        String
  description String?
  ownerName   String
  status      String   @default("completed") // Only store completed sessions
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  
  stories     PlanningPokerStory[]
  participants PlanningPokerParticipant[]
  
  @@index([sessionCode])
  @@index([createdAt])
}

model PlanningPokerStory {
  id            String   @id @default(cuid())
  title         String
  description   String?
  finalEstimate String?
  status        String   @default("completed") // Only store completed stories
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  session       PlanningPokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  
  votes         PlanningPokerVote[]
  
  @@index([sessionId])
}

model PlanningPokerParticipant {
  id        String   @id @default(cuid())
  name      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  joinedAt  DateTime @default(now())
  
  session   PlanningPokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  
  votes     PlanningPokerVote[]
  
  @@index([sessionId])
}

model PlanningPokerVote {
  id    String @id @default(cuid())
  value String // Final vote value: 1, 2, 3, 5, 8, 13, 21, ?, coffee
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  story         PlanningPokerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId       String
  
  participant   PlanningPokerParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  
  @@unique([storyId, participantId])
  @@index([storyId])
}